# Optional. Set this to the deployed Cloudflare Worker URL to enable anonymous
# live visitor astronauts. Leave empty to keep the map local-only.
NEXT_PUBLIC_PRESENCE_URL=

# EmailJS browser contact form (public identifiers; no private key required).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
